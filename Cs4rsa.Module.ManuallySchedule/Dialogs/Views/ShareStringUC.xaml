<UserControl
    x:Class="Cs4rsa.Module.ManuallySchedule.Dialogs.Views.ShareStringUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Cs4rsa.Module.ManuallySchedule.Dialogs.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ShareStringUCViewModel}"
    d:DesignHeight="200"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="240" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Border Padding="4">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,4"
                FontSize="13"
                FontWeight="SemiBold"
                Text="Share This Code" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Height="30"
                    Margin="0,0,4,0"
                    VerticalContentAlignment="Center"
                    AcceptsReturn="True"
                    Background="#f5f5f5"
                    IsReadOnly="True"
                    Text="{Binding ShareString}" />
                <Button
                    x:Name="CopyButton"
                    Grid.Column="1"
                    Width="60"
                    Height="30"
                    Click="CopyButton_Click"
                    Content="Copy" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
