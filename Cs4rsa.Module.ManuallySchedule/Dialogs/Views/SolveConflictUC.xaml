<UserControl
    x:Class="Cs4rsa.Module.ManuallySchedule.Dialogs.Views.SolveConflictUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:shared="clr-namespace:Cs4rsa.Module.Shared;assembly=Cs4rsa.Module.Shared"
    xmlns:vm="clr-namespace:Cs4rsa.Module.ManuallySchedule.Dialogs.ViewModels"
    Name="Root"
    Padding="4"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:SolveConflictViewModel}"
    d:Height="300"
    d:Width="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <shared:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="700" />
            <Setter Property="Height" Value="340" />
            <Setter Property="MaxWidth" Value="1000" />
            <Setter Property="MaxHeight" Value="1000" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            Text="This conflict can be solve by removing one of two classes" />
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,16"
            HorizontalAlignment="Center">
            <Run
                d:Text="CS 301 A"
                FontWeight="Bold"
                Text="{Binding ClassGroupModel_A.Name, Mode=OneWay}" />
            <Run Text="OR" />
            <Run
                d:Text="MAG 302 C"
                FontWeight="Bold"
                Text="{Binding ClassGroupModel_B.Name, Mode=OneWay}" />
            <Run Text="?" />
        </TextBlock>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="5"
                Background="#ecf0f1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="10"
                        Margin="0,0,5,0"
                        d:Background="#e056fd"
                        Background="{Binding ClassGroupModel_A.Color}"
                        CornerRadius="4" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            d:Text="Lập trình hướng đối tượng"
                            Text="{Binding ClassGroupModel_A.ClassGroup.SubjectName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            d:Text="CS 301"
                            Text="{Binding ClassGroupModel_A.Name, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Command="{Binding RemoveCgFirstCmd}"
                        Content="Unselect" />
                </Grid>
            </Border>
            <Border
                Grid.Column="1"
                Padding="5"
                Background="#ecf0f1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="10"
                        Margin="0,0,5,0"
                        d:Background="#7ed6df"
                        Background="{Binding ClassGroupModel_B.Color}"
                        CornerRadius="4" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            d:Text="Pháp thuật đại cương"
                            Text="{Binding ClassGroupModel_B.ClassGroup.SubjectName}"
                            TextWrapping="Wrap" />
                        <TextBlock d:Text="MAG 302" Text="{Binding ClassGroupModel_B.Name, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Command="{Binding RemoveCgSecondCmd}"
                        Content="Unselect" />
                </Grid>
            </Border>
        </Grid>
        <DataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding ConflictInfos}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    d:Width="50"
                    Binding="{Binding Day}"
                    Header="Days" />

                <DataGridTextColumn
                    d:Width="120"
                    Binding="{Binding ConflictDurian}"
                    Header="Conflict Durations" />

                <DataGridTextColumn
                    Width="*"
                    d:Width="100"
                    Binding="{Binding ClassGroupModel_A_TimeRange}">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock d:Text="CS 301 Times" Text="{Binding Data.ClassGroupModel_A.Name, Source={StaticResource Proxy}, StringFormat={}{0} Times}" />
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="*"
                    d:Width="100"
                    Binding="{Binding ClassGroupModel_B_TimeRange}">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock d:Text="MAG 302 Times" Text="{Binding Data.ClassGroupModel_B.Name, Source={StaticResource Proxy}, StringFormat={}{0} Times}" />
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
