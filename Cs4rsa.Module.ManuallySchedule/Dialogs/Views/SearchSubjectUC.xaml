<UserControl
    x:Class="Cs4rsa.Module.ManuallySchedule.Dialogs.Views.SearchSubjectUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cs4rsa.Module.ManuallySchedule.Dialogs.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:uihelper="clr-namespace:Cs4rsa.UI.Helper;assembly=Cs4rsa.UI.Helper"
    xmlns:vm="clr-namespace:Cs4rsa.Module.ManuallySchedule.Dialogs.ViewModels"
    Width="600"
    Height="350"
    Padding="2"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:SearchSubjectViewModel}"
    d:DesignHeight="350"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="ShowInTaskbar" Value="True" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary Source="/Cs4rsa.UI.Helper;component/ButtonStyle.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Search" />
        <TextBox
            x:Name="TextBox_SearchBox"
            Grid.Row="1"
            Height="24"
            Padding="4,2"
            uihelper:TextBoxHelper.Placeholder="Search your subjects..."
            TextChanged="TextBox_TextChanged" />
        <ListBox
            Grid.Row="2"
            Margin="0,0,0,8"
            ItemsSource="{Binding SubjectResults}">
            <d:ListBoxItem>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,4,0"
                            Fill="Aquamarine" />
                        <TextBlock Margin="0,0,4,0" Text="CS 101 - Lập trình Cơ sở" />
                        <TextBlock Text="- Lập trình cơ bản bao gồm C và C++" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" />
                </StackPanel>
            </d:ListBoxItem>

            <d:ListBoxItem>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,4,0"
                            Fill="Aquamarine" />
                        <TextBlock Margin="0,0,4,0" Text="ACC 201 - Nguyên Lý Kế Toán" />
                        <TextBlock Text="- Lập kế hoạch và hoạch định chiến lược..." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" />
                </StackPanel>
            </d:ListBoxItem>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,4,0"
                                Fill="{Binding Color}" />
                            <TextBlock Margin="0,0,4,0" Text="{Binding SubjectCode}" />
                            <TextBlock Text=" - " />
                            <TextBlock Margin="0,0,4,0" Text="{Binding SubjectName}" />
                            <TextBlock Text="{Binding SubjectDescription}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Command="{Binding ClosePopupCommand}"
                Content="Close"
                Style="{StaticResource ActionButton}" />
        </StackPanel>
    </Grid>
</UserControl>
