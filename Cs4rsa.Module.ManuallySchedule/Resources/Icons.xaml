    <!--  ============ SPIN STORYBOARD (dùng cho IconLoading) ============  -->
    <Storyboard x:Key="SpinLoadingStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation
            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
            From="0"
            To="360"
            Duration="0:0:1.2" />
    </Storyboard>

    <!--  Style tiện dụng: gắn sẵn RenderTransform + auto-spin khi Image.Loaded  -->
    <Style x:Key="SpinningLoadingIconStyle" TargetType="Image">
        <Setter Property="Source" Value="{StaticResource IconLoading}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource SpinLoadingStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
