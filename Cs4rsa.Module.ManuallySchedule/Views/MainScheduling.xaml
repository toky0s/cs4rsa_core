<UserControl
    x:Class="Cs4rsa.Module.ManuallySchedule.Views.MainScheduling"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Cs4rsa.WPF.Converter;assembly=Cs4rsa.WPF.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:info="clr-namespace:Cs4rsa.Module.ManuallySchedule"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:schedule="clr-namespace:Cs4rsa.UI.ScheduleTable.CustomControls;assembly=Cs4rsa.UI.ScheduleTable"
    xmlns:shared="clr-namespace:Cs4rsa.Module.Shared;assembly=Cs4rsa.Module.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:uc="clr-namespace:Cs4rsa.Module.ManuallySchedule.UC"
    xmlns:uihelper="clr-namespace:Cs4rsa.UI.Helper;assembly=Cs4rsa.UI.Helper"
    xmlns:views="clr-namespace:Cs4rsa.Module.ManuallySchedule.Views"
    xmlns:vm="clr-namespace:Cs4rsa.Module.ManuallySchedule.ViewModels"
    xmlns:vr="clr-namespace:Cs4rsa.Module.ManuallySchedule.ValidationRules"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Name="root"
    d:DataContext="{d:DesignInstance Type=vm:MainSchedulingViewModel}"
    d:Height="670"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <shared:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <cvt:GreaterThanZeroConverter x:Key="GreaterZero" />
            <cvt:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <cvt:StringListJoinConverter x:Key="JoinString" />
            <cvt:HalfHourTimeConverter x:Key="HalfHourTime" />
            <cvt:IsNotNullConverter x:Key="IsNotNull" />
            <vr:VR_SharedCode x:Key="vrSharedCode" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Cs4rsa.Module.ManuallySchedule;component/Resources/Icons.xaml" />
                <ResourceDictionary Source="/Cs4rsa.UI.Helper;component/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="350"
                MinWidth="350"
                d:Width="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" d:Width="800" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                Width="350"
                MinWidth="350"
                d:Width="400" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0" SelectedIndex="{Binding SearchBoxSelectedIndex}">
                <TabItem Header="Search">
                    <Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Grid.Column="0"
                                        ItemsSource="{Binding Disciplines}"
                                        SelectedItem="{Binding SelectedDiscipline}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <TextBlock Text="{Binding Name}" />
                                                </Border>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <GridSplitter
                                        Grid.Column="1"
                                        Width="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch" />
                                    <ComboBox
                                        Grid.Column="2"
                                        ItemsSource="{Binding DisciplineKeywordModels}"
                                        SelectedItem="{Binding SelectedKeyword}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                        <Border Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Ellipse
                                                                Width="12"
                                                                Height="12"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Fill="{Binding Color}" />
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Keyword1}" />
                                                        <TextBlock VerticalAlignment="Center" Text=" - " />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding SubjectName}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Cache, Converter={StaticResource IsNotNull}}" Value="{x:Static sys:Boolean.TrueString}" />
                                                            <Condition Binding="{Binding Data.IsConnected, Source={StaticResource Proxy}}" Value="{x:Static sys:Boolean.FalseString}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Data.IsConnected, Source={StaticResource Proxy}}" Value="{x:Static sys:Boolean.TrueString}">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <Border Grid.Column="3" Margin="4,0,0,0">
                                        <Button
                                            Width="50"
                                            Command="{Binding AddCommand}"
                                            Content="Add"
                                            Style="{StaticResource ActionButton}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="0,0,0,2">
                                <Grid>
                                    <TextBox
                                        Height="24"
                                        Padding="4,2"
                                        uihelper:TextBoxHelper.Placeholder="Search your subjects..."
                                        PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox
                                        Grid.Row="0"
                                        Margin="0,0,0,2"
                                        HorizontalContentAlignment="Stretch"
                                        ItemsSource="{Binding SubjectModels}"
                                        SelectedItem="{Binding SelectedSubjectModel}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                        <Setter Property="Cursor" Value="Wait" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="ContextMenu">
                                                    <Setter.Value>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <ContextMenu.Style>
                                                                <Style TargetType="ContextMenu">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsDownloading}" Value="False" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContextMenu.Style>
                                                            <MenuItem
                                                                Command="{Binding Data.GotoCourseCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="Open link" />
                                                            <MenuItem Command="{Binding Data.CopyErrorCommand, Source={StaticResource Proxy}}" Header="Copy error" />
                                                            <MenuItem
                                                                Command="{Binding Data.DeleteCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="Delete" />
                                                            <MenuItem
                                                                Command="{Binding Data.DetailCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Header="Details" />
                                                        </ContextMenu>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" IsEnabled="{Binding IsError}" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  Subject UI  -->
                                                    <Grid Grid.Row="0" Grid.Column="0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse
                                                                Grid.Column="0"
                                                                Width="8"
                                                                Height="8"
                                                                Margin="0,0,4,0"
                                                                Fill="{Binding Color}" />
                                                            <TextBlock Grid.Column="1" TextWrapping="WrapWithOverflow">
                                                                <Run FontSize="13" Text="{Binding SubjectCode}" />
                                                                <Run
                                                                    FontSize="13"
                                                                    Foreground="Gray"
                                                                    Text="→" />
                                                                <Run
                                                                    FontSize="10"
                                                                    FontStyle="Italic"
                                                                    Foreground="Gray"
                                                                    Text="{Binding SelectedClassGroupName, TargetNullValue=Unselected, FallbackValue=Unselected}" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <Grid Grid.Row="1">
                                                            <TextBlock Text="{Binding SubjectName}" TextWrapping="WrapWithOverflow" />
                                                        </Grid>

                                                    </Grid>

                                                    <!--  Xoá subject  -->
                                                    <Button
                                                        Grid.Column="1"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="DimGray"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Delete"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}, ConverterParameter=True}">
                                                        <Button.Content>
                                                            <Image
                                                                Width="20"
                                                                Height="20"
                                                                Source="{StaticResource IconTrash}" />
                                                        </Button.Content>
                                                    </Button>

                                                    <!--  ================================= Loading icon =================================  -->
                                                    <Image
                                                        Grid.Column="1"
                                                        Width="20"
                                                        Height="20"
                                                        Style="{StaticResource SpinningLoadingIconStyle}"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}, ConverterParameter=False}" />
                                                    <!--  ================================= Loading icon =================================  -->

                                                    <Border
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,4,0,0"
                                                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                FontSize="10"
                                                                Foreground="Red"
                                                                Text="There is an error!"
                                                                ToolTip="{Binding ErrorMessage}" />

                                                            <Button
                                                                Grid.Column="1"
                                                                Command="{Binding Data.ReloadCommand, Source={StaticResource Proxy}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Reload"
                                                                FontSize="10"
                                                                ToolTip="Re-download this subject" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right">
                                        <Button
                                            Command="{Binding DeleteAllCommand}"
                                            Content="_Delete All"
                                            Style="{StaticResource ActionButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Store">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding UserSchedules}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            FontSize="16"
                                            FontWeight="Medium"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,0,0,8"
                                            FontSize="10"
                                            Text="{Binding SaveDate, StringFormat={}{0:ddd dd/MM/yyyy HH:mm}}" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding Data.DeleteUserScheduleCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Delete">
                                                <Button.Content>
                                                    <uihelper:GapStackPanel Gap="4" Orientation="Horizontal">
                                                        <Image
                                                            Width="20"
                                                            Height="20"
                                                            Source="{StaticResource IconTrash}" />
                                                        <TextBlock Text="Delete" />
                                                    </uihelper:GapStackPanel>
                                                </Button.Content>
                                            </Button>
                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,4,0"
                                                    Command="{Binding Data.ShareCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}">
                                                    <Button.Content>
                                                        <uihelper:GapStackPanel Gap="2" Orientation="Horizontal">
                                                            <Image
                                                                Width="20"
                                                                Height="20"
                                                                Source="{StaticResource IconShare}" />
                                                            <TextBlock Text="Share" />
                                                        </uihelper:GapStackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button
                                                    Command="{Binding Data.LoadUserScheduleCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Load..." />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                uihelper:TextBoxHelper.Placeholder="Enter your shared code..."
                                TextInput="TextBox_TextInput">
                                <TextBox.Text>
                                    <Binding Path="ShareString" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <vr:VR_SharedCode />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Validation.ErrorTemplate">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <StackPanel>
                                                        <Border BorderBrush="Red" BorderThickness="1">
                                                            <AdornedElementPlaceholder />
                                                        </Border>
                                                        <TextBlock Foreground="Red" Text="{Binding [0].ErrorContent}" />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button
                                Grid.Column="1"
                                Command="{Binding LoadShareStringCommand}"
                                Content="Load..." />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <GridSplitter
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="White" />
            <TabControl Grid.Row="2">
                <TabItem>
                    <TabItem.Style>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSubjectModel}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>
                    <TabItem.Header>
                        <Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedSubjectModel.SubjectCode}" />
                            </StackPanel>
                        </Border>
                    </TabItem.Header>
                    <Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" HorizontalAlignment="Right">
                                <Button
                                    x:Name="SortButton"
                                    Click="SortButton_Click"
                                    Content="Sort"
                                    Style="{StaticResource ActionButton}">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="SortContextMenu">
                                            <MenuItem
                                                x:Name="SortByName"
                                                Click="SortField_Click"
                                                Command="{Binding SortCommand}"
                                                CommandParameter="Name"
                                                Header="Name"
                                                IsCheckable="True" />
                                            <MenuItem
                                                x:Name="SortBySlot"
                                                Click="SortField_Click"
                                                Command="{Binding SortCommand}"
                                                CommandParameter="EmptySeat"
                                                Header="Slot"
                                                IsCheckable="True" />
                                            <Separator />
                                            <MenuItem
                                                x:Name="SortAscending"
                                                Click="SortOrder_Click"
                                                Command="{Binding ChangeSortDirectionCommand}"
                                                CommandParameter="ASC"
                                                Header="Ascending"
                                                IsCheckable="True" />
                                            <MenuItem
                                                x:Name="SortDescending"
                                                Click="SortOrder_Click"
                                                Command="{Binding ChangeSortDirectionCommand}"
                                                CommandParameter="DESC"
                                                Header="Descending"
                                                IsCheckable="True" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <!--  /===============================Selected Class Groups===============================/  -->
                            <ListBox
                                x:Name="ListBox_SelectedClassGroupModels"
                                Grid.Row="1"
                                ItemsSource="{Binding SelectedClassGroupModelsView}"
                                SelectedItem="{Binding SelectedClassGroup}"
                                SelectionChanged="ListBox_ClassGroups_SelectionChanged"
                                SelectionMode="Single">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Command="{Binding Data.ShowDetailsSchoolClassesCommand, Source={StaticResource Proxy}}" Header="Select class..." />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" IsEnabled="{Binding IsSpecialClassGroup}" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="Gray"
                                                    Text=" → ">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCodeSchoolClassName}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="Gray"
                                                    Text="{Binding HasCodeSchoolClassName, Mode=OneWay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCodeSchoolClassName}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Text="{Binding EmptySeat, StringFormat={}{0} Seats}"
                                                TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Details" />
            </TabControl>
        </Grid>
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="White" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="7*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0">
                <TabControl>
                    <TabItem Header="Calendar">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Expander
                                    Grid.Row="0"
                                    Header="Học kỳ 1"
                                    IsExpanded="True">
                                    <schedule:ScheduleView_v2 Week="{Binding Week1}">
                                        <schedule:ScheduleView_v2.BlockItemTemplate>
                                            <DataTemplate>
                                                <schedule:ScheduleBlock TimeBlock="{Binding}" />
                                            </DataTemplate>
                                        </schedule:ScheduleView_v2.BlockItemTemplate>
                                    </schedule:ScheduleView_v2>
                                </Expander>
                                <Expander
                                    Grid.Row="1"
                                    Header="Học kỳ 2"
                                    IsExpanded="True">
                                    <schedule:ScheduleView_v2 Week="{Binding Week2}">
                                        <schedule:ScheduleView_v2.BlockItemTemplate>
                                            <DataTemplate>
                                                <schedule:ScheduleBlock TimeBlock="{Binding}" />
                                            </DataTemplate>
                                        </schedule:ScheduleView_v2.BlockItemTemplate>
                                    </schedule:ScheduleView_v2>
                                </Expander>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter
                Grid.Row="1"
                Height="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center" />
            <Border Grid.Row="2">
                <TabControl>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <TextBlock Text="Classes">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClassGroupModels.Count, Converter={StaticResource GreaterZero}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClassGroupModels.Count, Converter={StaticResource GreaterZero}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Classes" />
                                    <Run Text="{Binding SelectedClassGroupModels.Count, StringFormat=({0}), Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                Name="DataGrid_SelectedClassGroups"
                                Grid.Row="0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="True"
                                ItemsSource="{Binding SelectedClassGroupModels}"
                                PreviewKeyDown="DataGrid_KeyDown"
                                SelectionChanged="DataGrid_SelectedClassGroups_SelectionChanged"
                                VerticalGridLinesBrush="{x:Null}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="Color" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Rectangle Fill="{Binding Color, Mode=OneWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}" Header="Subject code" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding ClassGroup.SubjectName, Mode=OneWay}"
                                        Header="Subject name" />
                                    <DataGridTextColumn
                                        Binding="{Binding ClassGroup.RegisterCodes, Converter={StaticResource JoinString}, ConverterParameter=',', FallbackValue='-', TargetNullValue='-', Mode=OneWay}"
                                        Header="Register codes"
                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DeleteAllChooseCommand}"
                                        Content="_Unselect All"
                                        Style="{StaticResource ActionButton}" />
                                    <uihelper:GapStackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Gap="5"
                                        Orientation="Horizontal">
                                        <Button
                                            HorizontalAlignment="Right"
                                            Command="{Binding RemoveSelectedCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=DataGrid_SelectedClassGroups}"
                                            Content="_Remove Selection"
                                            Style="{StaticResource ActionButton}" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Command="{Binding SaveCommand}"
                                            Content="_Save"
                                            Style="{StaticResource ActionButton}" />
                                    </uihelper:GapStackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel VerticalAlignment="Center" uihelper:StackPanelExtensions.Gap="5">
                                <!--  ========================= Show warning =========================  -->
                                <uihelper:GapStackPanel Gap="4" Orientation="Horizontal">
                                    <uihelper:GapStackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WarningModels.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </uihelper:GapStackPanel.Style>
                                    <Image
                                        Width="14"
                                        Height="14"
                                        Source="{StaticResource IconWarning}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Warnings" />
                                        <Run Text="{Binding WarningModels.Count, StringFormat=({0}), Mode=OneWay}" />
                                    </TextBlock>
                                </uihelper:GapStackPanel>

                                <!--  ========================= Show True Change =========================  -->
                                <uihelper:GapStackPanel Gap="4" Orientation="Horizontal">
                                    <uihelper:GapStackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WarningModels.Count, Converter={StaticResource GreaterZero}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </uihelper:GapStackPanel.Style>
                                    <Image
                                        Width="14"
                                        Height="14"
                                        Source="{StaticResource IconCheck}" />
                                    <TextBlock Text="True Change" />
                                </uihelper:GapStackPanel>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <!--  =============================== Has warning ===============================  -->
                            <DataGrid
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                ItemsSource="{Binding WarningModels}"
                                VerticalGridLinesBrush="{x:Null}">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarningModels.Count, Converter={StaticResource GreaterZero}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Warning">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <uihelper:GapStackPanel
                                                    VerticalAlignment="Center"
                                                    Gap="4"
                                                    Orientation="Horizontal">
                                                    <Image
                                                        Width="14"
                                                        Height="14"
                                                        Source="{StaticResource IconError}" />
                                                    <TextBlock Text="{Binding WarningTitle}" />
                                                </uihelper:GapStackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Description}"
                                        Header="Description">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="Actions" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <Button
                                                        Command="{Binding Data.SolveConflictCommand, Source={StaticResource Proxy}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Solve..." />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!--  =============================== Has warning ===============================  -->

                            <!--  =============================== True Change ===============================  -->
                            <ScrollViewer
                                VerticalAlignment="Stretch"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarningModels.Count, Converter={StaticResource GreaterZero}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <uihelper:GapStackPanel
                                    VerticalAlignment="Top"
                                    Gap="5"
                                    Orientation="Horizontal">

                                    <Image
                                        Width="14"
                                        Height="14"
                                        Source="{StaticResource IconCheck}" />
                                    <TextBlock
                                        FontStyle="Italic"
                                        Foreground="#95a5a6"
                                        Text="Your changes do not cause any scheduling conflicts or locations that are too far apart." />
                                </uihelper:GapStackPanel>
                            </ScrollViewer>
                            <!--  =============================== True Change ===============================  -->
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <GridSplitter
            Grid.Column="3"
            Width="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="White" />
        <Grid Grid.Column="4">
            <TabControl>
                <TabItem Header="Filters">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Grid.Row="0">
                                <Expander Header="General" IsExpanded="True">
                                    <Border Padding="4,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox
                                                Grid.Row="0"
                                                Margin="0,0,0,4"
                                                IsChecked="{Binding SeatAvailable}">
                                                <CheckBox.Content>
                                                    <TextBlock Text="Show classes that still have slots" TextWrapping="WrapWithOverflow" />
                                                </CheckBox.Content>
                                            </CheckBox>
                                            <Border Grid.Row="1">
                                                <StackPanel>
                                                    <TextBlock Text="Time range" />
                                                    <xctk:RangeSlider
                                                        Name="RangeSlider"
                                                        d:HigherValue="28"
                                                        AutoToolTipPlacement="None"
                                                        AutoToolTipPrecision="0"
                                                        HigherValue="{Binding HighValue}"
                                                        IsSnapToTickEnabled="True"
                                                        LowerValue="{Binding LowValue}"
                                                        Maximum="28"
                                                        Minimum="0"
                                                        Orientation="Horizontal"
                                                        TickFrequency="1" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            Text="{Binding ElementName=RangeSlider, Path=LowerValue, Converter={StaticResource HalfHourTime}}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Center"
                                                            Text="--" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            Text="{Binding ElementName=RangeSlider, Path=HigherValue, Converter={StaticResource HalfHourTime}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Expander>


                                <!--  ====================== FILTER TRÊN TỪNG SUBJECT - START ======================  -->
                                <ItemsControl
                                    d:Background="#ecf0f1"
                                    d:Height="30"
                                    ItemsSource="{Binding VisibleFilters}">
                                    <d:ItemsControl>
                                        <d:TextBlock d:FontSize="20" d:Foreground="#2980b9">Subject Filters will be here</d:TextBlock>
                                    </d:ItemsControl>

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <!--<ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"></Style>
                                    </ItemsControl.ItemContainerStyle>-->

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander
                                                x:Name="Expander_Filter"
                                                d:DataContext="{d:DesignInstance Type=vm:FilterSubjectViewModel}"
                                                BorderThickness="1"
                                                IsExpanded="{Binding IsDisplayed}">
                                                <!--<Expander.Template>
                                                    <ControlTemplate TargetType="Expander">
                                                        <StackPanel>
                                                -->
                                                <!--  Header  -->
                                                <!--
                                                            <Border>
                                                                <ToggleButton
                                                                    x:Name="HeaderToggle"
                                                                    Padding="8,4"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="#ecf0f1"
                                                                    BorderThickness="0"
                                                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                                    <ContentPresenter ContentSource="Header" />
                                                                </ToggleButton>
                                                            </Border>
                                                -->
                                                <!--  Content  -->
                                                <!--
                                                            <ContentPresenter x:Name="Content" Visibility="Collapsed" />
                                                        </StackPanel>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="True">
                                                                <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Expander.Template>-->


                                                <!--  =========================== Header của từng filter ================================  -->
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,4,0"
                                                            Fill="{Binding Color}" />
                                                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                            <Run Text="{Binding SubjectCode}" />
                                                            <Run Text=" - " />
                                                            <Run Text="{Binding SubjectName}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Expander.Header>
                                                <!--  =========================== Header của từng filter ================================  -->


                                                <StackPanel>
                                                    <StackPanel.Resources>
                                                        <Style x:Key="Filter_Header" TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="0,0,0,5" />
                                                        </Style>
                                                    </StackPanel.Resources>
                                                    <!--  =========================== START - Body của từng filter ================================  -->
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Style="{StaticResource Filter_Header}" Text="Day of week" />
                                                        <xctk:WrapPanel Orientation="Horizontal">
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="All"
                                                                IsChecked="{Binding All}"
                                                                IsThreeState="True" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Mon"
                                                                IsChecked="{Binding Mon}" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Tue"
                                                                IsChecked="{Binding Tue}" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Wed"
                                                                IsChecked="{Binding Wed}" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Thu"
                                                                IsChecked="{Binding Thu}" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Fri"
                                                                IsChecked="{Binding Fri}" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Sat"
                                                                IsChecked="{Binding Sat}" />
                                                            <CheckBox
                                                                Margin="0,0,4,0"
                                                                Content="Sun"
                                                                IsChecked="{Binding Sun}" />
                                                        </xctk:WrapPanel>
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Filter_Header}" Text="Lectures" />
                                                        <uc:MultiSelection ItemsSource="{Binding Lectures}" SelectedItems="{Binding SelectedLectures}" />
                                                    </StackPanel>
                                                    <!--  =========================== END - Body của từng filter ================================  -->

                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!--  ====================== FILTER TRÊN TỪNG SUBJECT - END ======================  -->

                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button Content="Reset" Style="{StaticResource ActionButton}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
