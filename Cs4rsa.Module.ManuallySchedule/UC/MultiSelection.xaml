<UserControl
    x:Class="Cs4rsa.Module.ManuallySchedule.UC.MultiSelection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cs4rsa.Module.ManuallySchedule.UC"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uihelper="clr-namespace:Cs4rsa.UI.Helper;assembly=Cs4rsa.UI.Helper"
    d:DataContext="{d:DesignInstance Type=local:MultiSelection}"
    d:DesignHeight="200"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Cs4rsa.UI.Helper;component/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="0,0,0,2">
            <ItemsControl ItemsSource="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <!--  ============================= Preview UI =============================  -->
                <d:Border
                    Margin="0,0,2,2"
                    Padding="8,6"
                    Background="#bdc3c7"
                    CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Text="Phạm Xuân Ẩn" />
                        <Button
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}">
                            <Button.Content>
                                <Path
                                    Data="M5 5L19 19M5 19L19 5"
                                    Stretch="Fill"
                                    Stroke="Black"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </d:Border>
                <d:Border
                    Margin="0,0,2,2"
                    Padding="8,6"
                    Background="#bdc3c7"
                    CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Text="Nguyễn Văn Tàu" />
                        <Button
                            Width="10"
                            Height="10"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}">
                            <Button.Content>
                                <Path
                                    Data="M5 5L19 19M5 19L19 5"
                                    Stretch="Fill"
                                    Stroke="Black"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </d:Border>
                <!--  ============================= Preview UI =============================  -->

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="8,6"
                            d:DataContext="{d:DesignInstance Type=local:MultiSelectionItem}"
                            Background="#bdc3c7"
                            CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{Binding Label}" />
                                <Button
                                    Width="10"
                                    Height="10"
                                    Style="{StaticResource IconButtonStyle}">
                                    <Button.Content>
                                        <Path
                                            Data="M5 5L19 19M5 19L19 5"
                                            Stretch="Fill"
                                            Stroke="Black"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBox
            x:Name="TextBlock_Search"
            Grid.Row="1"
            Padding="8,4"
            d:Text="Search..."
            uihelper:TextBoxHelper.Placeholder="Search..."
            TextChanged="TextBlock_Search_TextChanged" />
        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SelectionChanged="ListBox_SelectionChanged"
            SelectionMode="Multiple">

            <!--  ============================= Preview UI =============================  -->
            <d:ListBoxItem>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        IsChecked="True" />
                    <TextBlock VerticalAlignment="Center" Text="Võ Nguyên Giáp" />
                </StackPanel>
            </d:ListBoxItem>
            <d:ListBoxItem>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <CheckBox Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="Lê Trọng Tấn" />
                </StackPanel>
            </d:ListBoxItem>
            <d:ListBoxItem>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <CheckBox Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="Nguyễn Ái Quốc" />
                </StackPanel>
            </d:ListBoxItem>
            <!--  ============================= Preview UI =============================  -->

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
