
<UserControl
    x:Class="Cs4rsa.App.Views.UserControls.DownloadUpdatesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:local="clr-namespace:Cs4rsa.App.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Cs4rsa.App.ViewModels"
    Padding="10"
    d:DataContext="{d:DesignInstance Type=vm:DownloadUpdatesDialogViewModel}"
    d:DesignHeight="200"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="240" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Cs4rsa.UI.Helper;component/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image
            Grid.Row="0"
            Width="300"
            gif:ImageBehavior.AnimateInDesignMode="True"
            gif:ImageBehavior.AnimatedSource="/Resources/CatDownloadingUpdate.gif"
            gif:ImageBehavior.AutoStart="True" />
        <ProgressBar
            Grid.Row="1"
            Height="20"
            Margin="0,0,0,4"
            Maximum="100"
            Minimum="0"
            Value="{Binding UpdateProgress}" />
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,4,0"
                Command="{Binding StopDownloadingCommand}"
                Content="Stop downloading on dev only"
                Cursor="Arrow"
                Style="{StaticResource ActionButton}" />
            <Button
                Command="{Binding ExitDownloadingUpdate}"
                Content="Exit downloading updates"
                Cursor="Arrow"
                Style="{StaticResource ActionButton}" />
        </StackPanel>
    </Grid>
</UserControl>
