<Window
    x:Class="Cs4rsa.App.Views.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Cs4rsa.WPF.Converter;assembly=Cs4rsa.WPF.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:Cs4rsa.App.ViewModels"
    Width="320"
    Height="150"
    d:DataContext="{d:DesignInstance Type=vm:StatusWindowViewModel}"
    d:Height="120"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="#eae8d9"
    BorderBrush="#7f8c8d"
    BorderThickness="1"
    Focusable="False"
    IsHitTestVisible="False"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <cvt:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <cvt:BooleanToVisibilityRevert x:Key="BoolToVisRevert" />
    </Window.Resources>
    <Border Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Text="Network Status" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="CONNECTED"
                        Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="DISCONNECTED"
                        Visibility="{Binding Connected, Converter={StaticResource BoolToVisRevert}}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <StackPanel>
                    <TextBlock
                        Text="Your network is stable, your data will be updated nearly realtime."
                        TextWrapping="WrapWithOverflow"
                        Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Text="Your network is not stable, your data will be fetched from cache. Some subjects will be disabled util your network be stable back."
                        TextWrapping="WrapWithOverflow"
                        Visibility="{Binding Connected, Converter={StaticResource BoolToVisRevert}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>