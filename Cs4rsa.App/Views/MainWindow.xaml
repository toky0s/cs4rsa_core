<Window
    x:Class="Cs4rsa.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Cs4rsa.WPF.Converter;assembly=Cs4rsa.WPF.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:info="clr-namespace:Cs4rsa.Module.Shared;assembly=Cs4rsa.Module.Shared"
    xmlns:local="clr-namespace:Cs4rsa.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:uc="clr-namespace:Cs4rsa.Views.UserControls"
    xmlns:views="clr-namespace:Cs4rsa.App.Views"
    xmlns:vm="clr-namespace:Cs4rsa.App.ViewModels"
    Title="Xếp lịch"
    Width="1400"
    Height="741.641"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <cvt:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <cvt:BooleanToVisibilityRevert x:Key="BoolToVisRevert" />
    </Window.Resources>
    <DockPanel>
        <!--  Toolbar đặt ở trên cùng  -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="File" IsEnabled="False" />
                <Button Content="Edit" IsEnabled="False" />
                <Button Content="View" IsEnabled="False" />
                <Separator />
                <Menu>
                    <MenuItem Header="_Help">
                        <MenuItem Command="{Binding CheckForUpdatesCommand}" Header="Check for Updates" />
                        <Separator />
                        <MenuItem Command="{Binding ResetCacheCommand}" Header="Reset Cache" />
                        <!--<MenuItem Header="_Exit" />-->
                    </MenuItem>
                </Menu>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Right">
                <Button Name="ShowNetworkStatusButton" Click="Button_ShowNetworkStatus_Click">

                    <Button.Content>
                        <StackPanel>
                            <TextBlock Text="Network Checking..." Visibility="{Binding IsNetworkChecking, Converter={StaticResource BoolToVis}}" />
                            <Grid Visibility="{Binding IsNetworkChecking, Converter={StaticResource BoolToVisRevert}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center">
                                    <Image
                                        Height="14"
                                        Source="/Cs4rsa.Module.ManuallySchedule;component/Resources/cross.png"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisRevert}}" />
                                    <Image
                                        Height="14"
                                        Source="/Cs4rsa.Module.ManuallySchedule;component/Resources/check.png"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Disconnected" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisRevert}}" />
                                    <TextBlock Text="Connected" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Nội dung chính  -->
            <Border Grid.Column="0">
                <ContentControl prism:RegionManager.RegionName="{x:Static info:RegionInfo.Manual}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>