<UserControl
    x:Class="Cs4rsa.UI.ScheduleTable.CustomControls.ScheduleView_v2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cs4rsa.UI.ScheduleTable.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:Cs4rsa.UI.ScheduleTable.Panels"
    x:Name="root"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ScheduleView_GridLineBrush" Color="#E0E0E0" />
        <Style TargetType="Border" x:Key="Border_DayOfWeek">
            <Setter Property="BorderBrush" Value="#E0E0E0"></Setter>
            <Setter Property="BorderThickness" Value="0,0,0.5,0"></Setter>
            <Setter Property="SnapsToDevicePixels" Value="True"></Setter>
        </Style>
        <Style x:Key="ScheduleView_TextBlock_Day" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <DataTemplate x:Key="ScheduleView_DefaultBlockTemplate">
            <local:ScheduleBlock
                BlockColor="{Binding Background}"
                BlockName="{Binding Content}"
                ScheduleTableItemType="{Binding ScheduleTableItemType}"
                TimeBlock="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>
    <Border
        Padding="{Binding Padding, ElementName=root}"
        Background="{Binding Background, ElementName=root}"
        BorderBrush="{Binding BorderBrush, ElementName=root}"
        BorderThickness="{Binding BorderThickness, ElementName=root}"
        CornerRadius="12"
        SnapsToDevicePixels="True">
        <!--
            Hàng thứ (Row 0) nằm NGOÀI ScrollViewer → cố định khi cuộn dọc.
            Phần mốc giờ + lưới tuần (Row 1) cuộn trong ScrollViewer.
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="48" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Ô góc (cột mốc giờ) — căn với cột timeline bên dưới  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Padding="0,0,0,5"
                BorderBrush="{StaticResource ScheduleView_GridLineBrush}"
                BorderThickness="0,0,0.5,0.5"
                SnapsToDevicePixels="True" />

            <!--  Hàng thứ: kẻ dọc giữa các thứ  -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Padding="0,0,0,5"
                BorderBrush="{StaticResource ScheduleView_GridLineBrush}"
                BorderThickness="0,0,0,0.5"
                SnapsToDevicePixels="True">
                <UniformGrid Columns="7" Rows="1" >
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="T2" />
                    </Border>
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="T3" />
                    </Border>
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="T4" />
                    </Border>
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="T5" />
                    </Border>
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="T6" />
                    </Border>
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="T7" />
                    </Border>
                    <Border Style="{StaticResource Border_DayOfWeek}">
                        <TextBlock Style="{StaticResource ScheduleView_TextBlock_Day}" Text="CN" />
                    </Border>
                </UniformGrid>

            </Border>

            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Height="{Binding ScheduleBodyHeight, ElementName=root}" MinHeight="{Binding ScheduleBodyMinHeight, ElementName=root}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Timeline: kẻ ngang full width (mốc giờ + vùng lưới)  -->
                    <panels:TimeLinePanel Grid.Column="0" Grid.ColumnSpan="2" SnapsToDevicePixels="True">

                       
                    </panels:TimeLinePanel>
                    <ItemsControl
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding ItemsSource, ElementName=root}"
                        SnapsToDevicePixels="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <panels:TimeLinePanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BorderBrush="{StaticResource ScheduleView_GridLineBrush}"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Text="{Binding}"
                                            TextOptions.TextFormattingMode="Display" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel 
                        Grid.Column="1"
                        Orientation="Vertical"
                        d:Visibility="Visible"
                        Visibility="Collapsed">
                        <TextBlock Text="07:00"/>
                        <TextBlock Text="08:00"/>
                        <TextBlock Text="09:00"/>
                        <!-- ... -->
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        BorderBrush="{StaticResource ScheduleView_GridLineBrush}"
                        BorderThickness="0.5"
                        CornerRadius="12"
                        d:Visibility="Collapsed"
                        SnapsToDevicePixels="True">
                        
                        <panels:WeekPanel
                            x:Name="Weekpanel"
                            Height="{Binding ElementName=IC_WeekPanelContainer, Path=Height}"
                            GridLineBrush="{StaticResource ScheduleView_GridLineBrush}"
                            ShowGridLines="True">
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="07:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="08:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="09:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="09:15" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="10:15" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="11:15" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="12:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="13:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="14:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="15:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="15:15" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="16:15" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="17:15" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="17:45" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="18:45" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="19:45" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border BorderBrush="{StaticResource ScheduleView_GridLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="21:00" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                        </panels:WeekPanel>

                        <!--<ItemsControl Name="IC_WeekPanelContainer" ItemsSource="{Binding Week, ElementName=root}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <panels:WeekPanel
                                        Height="{Binding ElementName=IC_WeekPanelContainer, Path=Height}"
                                        GridLineBrush="{StaticResource ScheduleView_GridLineBrush}"
                                        ShowGridLines="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border SnapsToDevicePixels="True">
                                        <ItemsControl ItemsSource="{Binding}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <panels:DayPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{Binding BlockItemTemplate, ElementName=root, TargetNullValue={StaticResource ScheduleView_DefaultBlockTemplate}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>-->
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
