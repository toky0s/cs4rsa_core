<UserControl
    x:Class="Cs4rsa.UI.Helper.MulSelection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <!--  TextBox  -->
            <TextBox
                x:Name="InputBox"
                Padding="5"
                Background="#ecf0f1"
                BorderBrush="#95a5a6"
                BorderThickness="1"
                GotFocus="InputBox_GotFocus"
                Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <!--  Chips  -->
            <ItemsControl ItemsSource="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="2"
                            Padding="5"
                            Background="#bdc3c7"
                            CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{Binding Label}" />
                                <Button
                                    Width="16"
                                    Height="16"
                                    Click="RemoveChip_Click"
                                    Content="X"
                                    DataContext="{Binding}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Dropdown  -->
            <Popup
                x:Name="DropdownPopup"
                IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Placement="Bottom"
                StaysOpen="True">
                <Border
                    Background="White"
                    BorderBrush="#95a5a6"
                    BorderThickness="1">
                    <ListBox ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=SelectedItems}" />
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_MouseLeftButtonUp" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="5" Text="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </StackPanel>
    </Grid>
</UserControl>